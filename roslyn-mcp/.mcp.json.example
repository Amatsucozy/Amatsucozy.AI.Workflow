{
  "mcpServers": {
    "roslyn": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/Amatsucozy/Amatsucozy.AI.Workflow.git@v1.0.0#subdirectory=roslyn-mcp",
        "roslyn-mcp"
      ],
      "env": {
        "ROSLYN_LSP_CMD": "C:/Users/<you>/.dotnet/tools/roslyn-language-server.cmd"
      }
    }
  }
}
